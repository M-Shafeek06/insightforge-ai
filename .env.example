# Backend dataset storage paths (relative to the backend working directory)
UPLOAD_DIR=../data/raw
PROCESSED_DIR=../data/processed

# Optional PostgreSQL configuration for the Docker Compose service.
# PostgreSQL is not currently integrated into the dataset/analytics routes.
POSTGRES_DB=insightforge
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=change_me_for_local_use
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://insightforge:change_me_for_local_use@localhost:5432/insightforge

# Next.js server-side API proxy target (set in the frontend process environment)
BACKEND_URL=http://127.0.0.1:8000
